{"alignments": [{"id": "PSA.140.13.a001", "note": "Asseverative particle.", "source": ["WLC.PSA.140.13.001"], "source_head": "WLC.PSA.140.13.001", "status": "aligned", "target": ["t001"], "target_head": "t001"}, {"id": "PSA.140.13.a002", "note": "Anarthrous substantival adjective takes the supplied *the* (rule 46), headed on the word carrying the lexeme.", "source": ["WLC.PSA.140.13.002"], "source_head": "WLC.PSA.140.13.002", "status": "aligned", "target": ["t002", "t003"], "target_head": "t003"}, {"id": "PSA.140.13.a003", "note": "Light verb plus complement heads on the complement (rule 44); the auxiliary belongs to the verb under rule 17.", "source": ["WLC.PSA.140.13.003"], "source_head": "WLC.PSA.140.13.003", "status": "aligned", "target": ["t004", "t005", "t006"], "target_head": "t006"}, {"id": "PSA.140.13.a004", "note": "Preposition rendered *unto*.", "source": ["WLC.PSA.140.13.004"], "source_head": "WLC.PSA.140.13.004", "status": "aligned", "target": ["t007"], "target_head": "t007"}, {"id": "PSA.140.13.a005", "note": "Noun.", "source": ["WLC.PSA.140.13.005"], "source_head": "WLC.PSA.140.13.005", "status": "aligned", "target": ["t009"], "target_head": "t009"}, {"id": "PSA.140.13.a006", "note": "Possessive suffix (rule 18).", "source": ["WLC.PSA.140.13.006"], "source_head": "WLC.PSA.140.13.006", "status": "aligned", "target": ["t008"], "target_head": "t008"}, {"id": "PSA.140.13.a007", "note": "Finite verb with auxiliary (rule 17).", "source": ["WLC.PSA.140.13.007"], "source_head": "WLC.PSA.140.13.007", "status": "aligned", "target": ["t012", "t013"], "target_head": "t013"}, {"id": "PSA.140.13.a008", "note": "Anarthrous substantival adjective takes the supplied *The* (rule 46).", "source": ["WLC.PSA.140.13.008"], "source_head": "WLC.PSA.140.13.008", "status": "aligned", "target": ["t010", "t011"], "target_head": "t011"}, {"id": "PSA.140.13.a009", "note": "The preposition `אֵת` (H854), rendered *in*; not the object marker H853 (rule 16).", "source": ["WLC.PSA.140.