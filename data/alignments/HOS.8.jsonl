{"alignments": [{"id": "HOS.8.1.a001", "note": "", "source": ["WLC.HOS.8.1.001"], "source_head": "WLC.HOS.8.1.001", "status": "aligned", "target": ["t004"], "target_head": "t004"}, {"id": "HOS.8.1.a002", "note": "", "source": ["WLC.HOS.8.1.002"], "source_head": "WLC.HOS.8.1.002", "status": "aligned", "target": ["t006"], "target_head": "t006"}, {"id": "HOS.8.1.a003", "note": "", "source": ["WLC.HOS.8.1.003"], "source_head": "WLC.HOS.8.1.003", "status": "aligned", "target": ["t005"], "target_head": "t005"}, {"id": "HOS.8.1.a004", "note": "The supplied definite article belongs to the noun.", "source": ["WLC.HOS.8.1.004"], "source_head": "WLC.HOS.8.1.004", "status": "aligned", "target": ["t002", "t003"], "target_head": "t003"}, {"id": "HOS.8.1.a005", "note": "The Hebrew clause has no verb corresponding to the supplied imperative Set.", "source": [], "source_head": null, "status": "added", "target": ["t001"], "target_head": "t001"}, {"id": "HOS.8.1.a006", "note": "", "source": ["WLC.HOS.8.1.005"], "source_head": "WLC.HOS.8.1.005", "status": "aligned", "target": ["t007"], "target_head": "t007"}, {"id": "HOS.8.1.a007", "note": "The ASV uses an rather than a definite article.", "source": ["WLC.HOS.8.1.006"], "source_head": "WLC.HOS.8.1.006", "status": "unrepresented", "target": [], "target_head": null}, {"id": "HOS.8.1.a008", "note": "The indefinite article belongs to the noun.", "source": ["WLC.HOS.8.1.007"], "source_head": "WLC.HOS.8.1.007", "status": "aligned", "target": ["t008", "t009"], "target_head": "t009"}, {"id": "HOS.8.1.a009", "note": "The pronoun belongs to the ASV's supplied clause and has no source nominal.", "source": [], "source_head": null, "status": "added", "target": ["t010"], "target_head": "t010"}, {"id": "HOS.8.1.a010", "note": "The Hebrew has no verb corresponding to cometh; the alternative rendering preserves the verbless construction.", "source": [], "source_head": null, "status": "added", "target": ["t011"], "target_head": "t011"}, {"id": "HOS.8.1.