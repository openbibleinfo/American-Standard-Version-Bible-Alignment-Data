{"alignments": [{"id": "PSA.48.10.a001", "note": "", "source": ["WLC.PSA.48.10.001"], "source_head": "WLC.PSA.48.10.001", "status": "aligned", "target": ["t001"], "target_head": "t001"}, {"id": "PSA.48.10.a002", "note": "The ASV expands the comparative phrase into a clause; the construction-supplied 'is' joins the nominal anchor under rule 20. Competing home: the comparative כְּ, which is not the clause's predicate, so the noun was preferred.", "source": ["WLC.PSA.48.10.002"], "source_head": "WLC.PSA.48.10.002", "status": "aligned", "target": ["t002", "t004"], "target_head": "t004"}, {"id": "PSA.48.10.a003", "note": "", "source": ["WLC.PSA.48.10.003"], "source_head": "WLC.PSA.48.10.003", "status": "aligned", "target": ["t003"], "target_head": "t003"}, {"id": "PSA.48.10.a004", "note": "Vocative takes supplied 'O' (rule 36).", "source": ["WLC.PSA.48.10.004"], "source_head": "WLC.PSA.48.10.004", "status": "aligned", "target": ["t005", "t006"], "target_head": "t006"}, {"id": "PSA.48.10.a005", "note": "", "source": ["WLC.PSA.48.10.005"], "source_head": "WLC.PSA.48.10.005", "status": "aligned", "target": ["t007"], "target_head": "t007"}, {"id": "PSA.48.10.a006", "note": "", "source": ["WLC.PSA.48.10.006"], "source_head": "WLC.PSA.48.10.006", "status": "aligned", "target": ["t010"], "target_head": "t010"}, {"id": "PSA.48.10.a007", "note": "", "source": ["WLC.PSA.48.10.007"], "source_head": "WLC.PSA.48.10.007", "status": "aligned", "target": ["t009"], "target_head": "t009"}, {"id": "PSA.48.10.a008", "note": "Prepositional predicate takes the construction-supplied copula (rule 49), discontinuous around the subject.", "source": ["WLC.PSA.48.10.008"], "source_head": "WLC.PSA.48.10.008", "status": "aligned", "target": ["t008", "t011"], "target_head": "t011"}, {"id": "PSA.48.10.a009", "note": "Construct noun takes supplied 'the' (rule 29).", "source": ["WLC.PSA.48.10.009"], "source_head": "WLC.PSA.48.10.009", "status": "aligned", "target": ["t012", "t013"], "target_head": "t013"