 ["WLC.PSA.127.1.017", "WLC.PSA.127.1.019"], "source_head": "WLC.PSA.127.1.019", "status": "aligned", "target": ["t019"], "target_head": "t019"}, {"id": "PSA.127.1.a017", "note": "", "source": ["WLC.PSA.127.1.018"], "source_head": "WLC.PSA.127.1.018", "status": "aligned", "target": ["t020"], "target_head": "t020"}, {"id": "PSA.127.1.a018", "note": "", "source": ["WLC.PSA.127.1.020"], "source_head": "WLC.PSA.127.1.020", "status": "aligned", "target": ["t021"], "target_head": "t021"}, {"id": "PSA.127.1.a019", "note": "Supplied *the* joins the noun (rule 15).", "source": ["WLC.PSA.127.1.021"], "source_head": "WLC.PSA.127.1.021", "status": "aligned", "target": ["t022", "t023"], "target_head": "t023"}, {"id": "PSA.127.1.a020", "note": "Adverbial accusative *in vain* (rule 33).", "source": ["WLC.PSA.127.1.022"], "source_head": "WLC.PSA.127.1.022", "status": "aligned", "target": ["t028", "t029"], "target_head": "t029"}, {"id": "PSA.127.1.a021", "note": "", "source": ["WLC.PSA.127.1.023"], "source_head": "WLC.PSA.127.1.023", "status": "aligned", "target": ["t026"], "target_head": "t026"}, {"id": "PSA.127.1.a022", "note": "Anarthrous substantival participle; supplied *The* joins it under rule 46.", "source": ["WLC.PSA.127.1.024"], "source_head": "WLC.PSA.127.1.024", "status": "aligned", "target": ["t024", "t025"], "target_head": "t025"}, {"id": "PSA.127.1.a023", "note": "Restrictive *but* (= only) answers to no morpheme; not the vanity noun's rendering, since dropping it leaves *in vain* intact (rule 30).", "source": [], "source_head": null, "status": "added", "target": ["t027"], "target_head": "t027"}], "ref": "PSA.127.1", "review_notes": ["אִם לֹא fused as *Except* twice, headed on the negative.", "*it* of *build it* given to the suffix on the participle (s014); בּוֹ and its suffix unrepresented."], "source_edition": "ASV-alignment Hebrew projection", "target_edition": "ASV", "variant_decisions": []}
