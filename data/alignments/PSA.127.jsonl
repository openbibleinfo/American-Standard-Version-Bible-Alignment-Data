{"alignments": [{"id": "PSA.127.1.a001", "note": "Construct noun; supplied indefinite article joins the noun under rule 15.", "source": ["WLC.PSA.127.1.001"], "source_head": "WLC.PSA.127.1.001", "status": "aligned", "target": ["t001", "t002"], "target_head": "t002"}, {"id": "PSA.127.1.a002", "note": "Article on the rectum; ASV writes no *the* anywhere in the phrase (rule 29).", "source": ["WLC.PSA.127.1.002"], "source_head": "WLC.PSA.127.1.002", "status": "unrepresented", "target": [], "target_head": null}, {"id": "PSA.127.1.a003", "note": "Nomen rectum takes *of* under rule 19.", "source": ["WLC.PSA.127.1.003"], "source_head": "WLC.PSA.127.1.003", "status": "aligned", "target": ["t003", "t004"], "target_head": "t004"}, {"id": "PSA.127.1.a004", "note": "Authorial lamed rendered *of*.", "source": ["WLC.PSA.127.1.004"], "source_head": "WLC.PSA.127.1.004", "status": "aligned", "target": ["t005"], "target_head": "t005"}, {"id": "PSA.127.1.a005", "note": "", "source": ["WLC.PSA.127.1.005"], "source_head": "WLC.PSA.127.1.005", "status": "aligned", "target": ["t006"], "target_head": "t006"}, {"id": "PSA.127.1.a006", "note": "אִם ... לֹא fused as *Except*, which carries both the condition and the negation (rules 30, 35); headed on the negative under rule 23. Discontinuous across the subject. Competing reading: head on אִם as the syntactic head.", "source": ["WLC.PSA.127.1.006", "WLC.PSA.127.1.008"], "source_head": "WLC.PSA.127.1.008", "status": "aligned", "target": ["t007"], "target_head": "t007"}, {"id": "PSA.127.1.a007", "note": "", "source": ["WLC.PSA.127.1.007"], "source_head": "WLC.PSA.127.1.007", "status": "aligned", "target": ["t008"], "target_head": "t008"}, {"id": "PSA.127.1.a008", "note": "", "source": ["WLC.PSA.127.1.009"], "source_head": "WLC.PSA.127.1.009", "status": "aligned", "target": ["t009"], "target_head": "t009"}, {"id": "PSA.127.1.a009", "note": "Supplied definite article joins the noun under rule 15.", "source": ["WLC.PSA.127.1.010"], "source_head": "W