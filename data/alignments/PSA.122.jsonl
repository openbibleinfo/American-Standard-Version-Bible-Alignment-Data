{"alignments": [{"id": "PSA.122.5.a001", "note": "", "source": ["WLC.PSA.122.5.001"], "source_head": "WLC.PSA.122.5.001", "status": "aligned", "target": ["t001"], "target_head": "t001"}, {"id": "PSA.122.5.a002", "note": "Adverb with its directive he rendered by the single word 'there'; the two share a unit under rules 30 and 32, headed on the lexeme-bearing adverb. Alternative: the he unrepresented beside 'there'.", "source": ["WLC.PSA.122.5.002", "WLC.PSA.122.5.003"], "source_head": "WLC.PSA.122.5.002", "status": "aligned", "target": ["t002"], "target_head": "t002"}, {"id": "PSA.122.5.a003", "note": "'they sat' recast as 'are set'; head on the lexical word. Margin 'were' read and set aside.", "source": ["WLC.PSA.122.5.004"], "source_head": "WLC.PSA.122.5.004", "status": "aligned", "target": ["t003", "t004"], "target_head": "t004"}, {"id": "PSA.122.5.a004", "note": "", "source": ["WLC.PSA.122.5.005"], "source_head": "WLC.PSA.122.5.005", "status": "aligned", "target": ["t005"], "target_head": "t005"}, {"id": "PSA.122.5.a005", "note": "", "source": ["WLC.PSA.122.5.006"], "source_head": "WLC.PSA.122.5.006", "status": "aligned", "target": ["t006"], "target_head": "t006"}, {"id": "PSA.122.5.a006", "note": "", "source": ["WLC.PSA.122.5.007"], "source_head": "WLC.PSA.122.5.007", "status": "aligned", "target": ["t007"], "target_head": "t007"}, {"id": "PSA.122.5.a007", "note": "Supplied 'The' belongs to the noun (rule 15).", "source": ["WLC.PSA.122.5.008"], "source_head": "WLC.PSA.122.5.008", "status": "aligned", "target": ["t008", "t009"], "target_head": "t009"}, {"id": "PSA.122.5.a008", "note": "Possessive lamed rendered 'of'.", "source": ["WLC.PSA.122.5.009"], "source_head": "WLC.PSA.122.5.009", "status": "aligned", "target": ["t010"], "target_head": "t010"}, {"id": "PSA.122.5.a009", "note": "Supplied 'the' on the construct (rule 29).", "source": ["WLC.PSA.122.5.010"], "source_head": "WLC.PSA.122.5.010", "status": "aligned", "target": ["t011", "t012"], "target_head": "t01