{"alignments": [{"id": "JER.47.4.a001", "note": "The compound English preposition 'because of' is one rendering, headed on 'because'.", "source": ["WLC.JER.47.4.001"], "source_head": "WLC.JER.47.4.001", "status": "aligned", "target": ["t001", "t002"], "target_head": "t001"}, {"id": "JER.47.4.a002", "note": "", "source": ["WLC.JER.47.4.002"], "source_head": "WLC.JER.47.4.002", "status": "aligned", "target": ["t003"], "target_head": "t003"}, {"id": "JER.47.4.a003", "note": "", "source": ["WLC.JER.47.4.003"], "source_head": "WLC.JER.47.4.003", "status": "aligned", "target": ["t004"], "target_head": "t004"}, {"id": "JER.47.4.a004", "note": "The attributive article is rendered by the relative 'that'.", "source": ["WLC.JER.47.4.004"], "source_head": "WLC.JER.47.4.004", "status": "aligned", "target": ["t005"], "target_head": "t005"}, {"id": "JER.47.4.a005", "note": "", "source": ["WLC.JER.47.4.005"], "source_head": "WLC.JER.47.4.005", "status": "aligned", "target": ["t006"], "target_head": "t006"}, {"id": "JER.47.4.a006", "note": "", "source": ["WLC.JER.47.4.006"], "source_head": "WLC.JER.47.4.006", "status": "aligned", "target": ["t007"], "target_head": "t007"}, {"id": "JER.47.4.a007", "note": "", "source": ["WLC.JER.47.4.007"], "source_head": "WLC.JER.47.4.007", "status": "aligned", "target": ["t008"], "target_head": "t008"}, {"id": "JER.47.4.a008", "note": "The direct-object marker has no separate English realization.", "source": ["WLC.JER.47.4.008"], "source_head": "WLC.JER.47.4.008", "status": "unrepresented", "target": [], "target_head": null}, {"id": "JER.47.4.a009", "note": "", "source": ["WLC.JER.47.4.009"], "source_head": "WLC.JER.47.4.009", "status": "aligned", "target": ["t009"], "target_head": "t009"}, {"id": "JER.47.4.a010", "note": "The supplied definite article belongs to the articleless gentilic noun.", "source": ["WLC.JER.47.4.010"], "source_head": "WLC.JER.47.4.010", "status": "aligned", "target": ["t010", "t011"], "target_head": "t011"}, {"id": "JER.47.